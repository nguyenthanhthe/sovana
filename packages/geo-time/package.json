{
  "name": "@sovana/geo-time",
  "version": "0.1.0",
  "description": "Zero-dependency NASA JPL ephemeris, bi-temporal Vietnam GIS (63<->34 provinces), historical timezone resolver, Meeus True Solar Time, and Vincenty geodesic engine.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": {
      "node": {
        "types": "./dist/data.d.ts",
        "default": "./dist/data.js"
      },
      "browser": {
        "types": "./dist/data.browser.d.ts",
        "default": "./dist/data.browser.js"
      },
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "node scripts/copy-specs.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyenthanhthe/sovana.git",
    "directory": "packages/geo-time"
  },
  "keywords": [
    "sovana",
    "ephemeris",
    "jpl",
    "true-solar-time",
    "vietnam",
    "timezone",
    "gis",
    "lunisolar",
    "vincenty"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
